# Recall layer — local-model wiring. THE ZERO-CODE HALF.
#
# deja-vu already probes Ollama :11434 then LM Studio :1234 and honours these
# vars, so pointing recall at your own GPU needs no code at all. Copy what you
# need into your shell profile.
#
# Grounded in .prism/shared/research/2026-09-06-dejavu-recall.md
# Design:      .prism/shared/designs/2026-09-06-recall-layer.md

# ── embeddings: local model as the rerank / semantic backend ────────────────
# Ollama is probed FIRST, so with a default Ollama install you may not need to
# set anything at all.
DEJA_EMBED_URL=http://127.0.0.1:11434
DEJA_EMBED_MODEL=nomic-embed-text
# DEJA_EMBED_KEY=            # only if your endpoint requires one

# LM Studio instead (probed second):
# DEJA_EMBED_URL=http://127.0.0.1:1234/v1
# DEJA_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Search is lexical BM25 (k1=1.2, b=0.75) with a 6-tier ladder. Embeddings are
# OPTIONAL: they rerank <=64 hits, and the semantic tier fires only when lexical
# returns zero. A local model that is slow or down degrades recall quality; it
# never breaks recall.
#
# ARKESTRA: an embedding call to a local endpoint is a credential-bound,
# local-provider request. Under the provider axis it must never fail over to a
# cloud model — recall must not become a data-egress path.

# ── SessionStart auto-recall dial ──────────────────────────────────────────
#   off        no injection
#   safe       2048 B / 3 sessions / project-scoped / Jaccard-0.80 dedup
#   aggressive 4096 B / 6 sessions / machine-wide
#
# An UNKNOWN value falls back to `safe`, never to aggressive. Keep that property
# in anything we build on top of it.
DEJA_RECALL=safe

# ── byte budgets (defaults; shown so they are visible, not to be raised idly) ──
# recall 4096 · context 8192 · blame 8192
#
# The discipline is in HOW the trim happens: frame overhead and the env block are
# subtracted BEFORE trimming; the paging line and the "digest trimmed" marker are
# reserved BEFORE cutting; truncation is rune-safe; and a tidy line-break is
# refused if it would drop a query word.
